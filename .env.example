# ==============================================================================
# FINENCLAVE : CONFIGURATION D'ENVIRONNEMENT
# ==============================================================================
# Sans clé ni serveur local, `uv run python main.py` rejoue les lectures scellées du dossier
# de démonstration (aucun appel réseau) ; sur un nouveau dossier, le moteur hors ligne
# règles + Tesseract prend le relais.

# Mode : 'openrouter' (développement), 'openai', 'local_gx10' (station air-gapped) ou 'mock'
LLM_BACKEND=openrouter

# Développement : OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
# Modèle de rédaction des notes (option --llm-notes)
# Défaut du code : modèle 72B (RedHatAI/Qwen2.5-VL-72B-Instruct-FP8-dynamic) ;
# sur OpenRouter, son équivalent BF16 :
LLM_MODEL=qwen/qwen2.5-vl-72b-instruct

# Modèle de vision : lecture des pièces (72B, tient sur le GX10 ; même défaut)
VLM_MODEL=qwen/qwen2.5-vl-72b-instruct
# Chemin de Tesseract si absent du PATH (secours hors ligne + OCR témoin anti-hallucination)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# ------------------------------------------------------------------------------
# Station ASUS Ascent GX10 (air-gap strict : seul localhost est accepté)
#   ./deploy/vllm_service.sh ensemble   (T1 sur :8000, voir deploy/README.md)
# ------------------------------------------------------------------------------
# LLM_BACKEND=local_gx10
# LOCAL_LLM_URL=http://localhost:8000/v1
# VLM_MODEL=RedHatAI/Qwen2.5-VL-72B-Instruct-FP8-dynamic
# LLM_MODEL=RedHatAI/Qwen2.5-VL-72B-Instruct-FP8-dynamic
# T1_MODEL=RedHatAI/Qwen2.5-VL-72B-Instruct-FP8-dynamic
# LLM_API_KEY=EMPTY

# Identifiants de modèles alignés sur les lectures scellées de data/demo (source unique :
# MODEL_SMALL / MODEL_LARGE dans src/fin_enclave/config.py ; 8B = Qwen/Qwen3-VL-8B-Instruct).
# Le rejeu des lectures scellées est prioritaire dès qu'il couvre tout le dossier.

# Requêtes d'extraction en vol : à aligner sur `--max-num-seqs` du serveur vLLM (défaut 8)
# EXTRACTION_WORKERS=8

# Options
AUTO_OPEN_GRAPH=false
OUTPUT_DIR=data/outputs
